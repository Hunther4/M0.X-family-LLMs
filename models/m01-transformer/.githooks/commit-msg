#!/usr/bin/env python3
"""Reject non-conventional commit subjects."""

from __future__ import annotations

import pathlib
import re
import sys


PATTERN = re.compile(r"^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._-]+\))?!?: .+")


def main() -> int:
    if len(sys.argv) < 2:
        print("commit-msg hook requires a message file path", file=sys.stderr)
        return 1

    message_path = pathlib.Path(sys.argv[1])
    try:
        subject = message_path.read_text(encoding="utf-8").splitlines()[0].strip()
    except Exception as exc:  # pragma: no cover - hook runtime guard
        print(f"Unable to read commit message: {exc}", file=sys.stderr)
        return 1

    if subject.startswith(("Merge ", "Revert ", "fixup! ", "squash! ")):
        return 0

    if not PATTERN.match(subject):
        print(
            "Invalid commit subject. Use conventional commits, e.g. 'feat(scope): description'.",
            file=sys.stderr,
        )
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
